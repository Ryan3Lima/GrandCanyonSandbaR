#'
#' @return A static ggplot object representing the hydrograph.
#'
#' @examples
#' plotStaticHydrograph(Qdat = SampleQ_xts_cfs,
#'   title= "Colorado River Discharge at Lees Ferry",
#'   subtitle = "October 3rd 2014 - October 11th 2014")
#'
#' @importFrom ggplot2 ggplot aes geom_line labs
#' @export
plotStaticHydrograph <- function(Qdat, title = "Hydrograph", subtitle = "subtitle", unit = 'CFS') {
library(ggplot2)
# Ensure data is in a dataframe format for ggplot2
if (!is.data.frame(Qdat)) {
Qdat_df <- data.frame(Time = index(Qdat), Discharge = coredata(Qdat))
} else {
Qdat_df <- Qdat
}
# Define the y-axis label based on the unit
ylab <- if (unit == 'CFS') "Discharge (CFS)" else if (unit == 'CFS') "Discharge (CMS)" else stop("Invalid unit specified")
# Create the plot
p <- ggplot(Qdat_df, aes(x = Time, y = Discharge)) +
geom_line() +  # Draw the line
labs(title = title, subtitle = subtitle, y = ylab, x = "Time") +
theme_minimal()  # Clean theme
return(p)
}
